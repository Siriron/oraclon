# Copy this file to .env and fill in the real value.
# NEVER commit the real .env — it holds a real private key with real GEN.

# Private key of the wallet that will call resolve_dispute() on GenLayer.
# This can be any funded StudioNet account — it does not need to be the
# relayer key from /relayer, and does not need to be either agent's key.
RESOLVER_PRIVATE_KEY=0xyourprivatekeyhere

# How often to check for resolvable disputes, in seconds. 30 is a
# reasonable default for a live demo; raise it for longer unattended runs
# to reduce RPC load.
POLL_INTERVAL_SECONDS=30
