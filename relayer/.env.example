# Copy this file to .env and fill in the real value.
# NEVER commit the real .env — it holds a real private key with real ETH.

# Private key of the address set as `relayer` in OraclonEscrow.sol
# (the address passed as _relayer to the constructor, or later set via
# setRelayer()). Must be funded with a small amount of Base Sepolia ETH
# to pay gas for submitVerdict().
RELAYER_PRIVATE_KEY=0xyourprivatekeyhere

# Optional — override the default public Base Sepolia RPC if you have
# your own (Alchemy/Infura/etc). Falls back to https://sepolia.base.org
# if unset.
BASE_SEPOLIA_RPC_URL=
